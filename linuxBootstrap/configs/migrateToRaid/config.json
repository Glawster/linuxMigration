{
  "remoteHost": "raid-pc",
  "remoteUser": "andy",
  "destinationMount": "/mnt/storage",
  "destinationFsType": "fuse.mergerfs",
  "minFreeBytesAfter": 10737418240,
  "checksum": "sha256sum",
  "excludes": ["lost+found", "$RECYCLE.BIN", "System Volume Information"],
  "protection": {
    "name": "SnapRAID parity",
    "command": "<RAID_PROTECTION_CHECK_COMMAND>",
    "successExitCodes": [0]
  },
  "localDestination": {
    "mount": "/mnt/media",
    "fsType": "ext4",
    "uuid": "<MEDIA_FS_UUID>",
    "protection": {
      "required": false
    }
  },
  "mappings": [
    { "name": "movie2", "label": "Movies 2", "type": "movies", "source": "/mnt/movie2/Movies", "mountPoint": "/mnt/movie2", "destination": "/mnt/storage/Movies", "enabled": false },
    { "name": "video3", "label": "TV 3", "type": "tv", "source": "/mnt/video3/TV", "mountPoint": "/mnt/video3", "destination": "/mnt/storage/TV", "enabled": false },
    { "name": "myVideo", "label": "My Video", "type": "video", "source": "/mnt/myVideo", "excludes": ["TV", "encrypted", "decrypted"], "target": "local", "destination": "/mnt/media/homeVideo", "enabled": false },
    { "name": "myVideoTV", "label": "My Video TV", "type": "tv", "source": "/mnt/myVideo/TV", "mountPoint": "/mnt/myVideo", "destination": "/mnt/storage/TV", "enabled": false },
    { "name": "myPictures", "label": "Pictures", "type": "pictures", "source": "/mnt/myPictures", "excludes": ["Movies"], "target": "local", "destination": "/mnt/media/Pictures", "enabled": false },
    { "name": "myPicturesMovies", "label": "My Pictures Movies", "type": "movies", "source": "/mnt/myPictures/Movies", "mountPoint": "/mnt/myPictures", "destination": "/mnt/storage/Movies", "enabled": false }
  ]
}
