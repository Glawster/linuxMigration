/* Colour roles come from myStyles.css, including the warning palette. */

.action-needed {
    height: auto;
    border: none;
    text-style: bold;
}

Screen > TabbedContent {
    height: 1fr;
}

Screen > TabbedContent > ContentSwitcher {
    height: 1fr;
}

#inboxInterest {
    height: 1fr;
}

#digest-menu {
    height: 1fr;
}

#digest-menu > ContentSwitcher {
    height: 1fr;
}

#digestSenders,
#digestReasons,
#inboxFiling {
    height: 1fr;
}

FilingView {
    height: 1fr;
    layout: vertical;
    overflow: hidden;
}

FilingView #filing-summary {
    height: 1;
}

FilingView #filing-table {
    height: 1fr;
    min-height: 8;
    scrollbar-gutter: stable;
    overflow-x: hidden;
}

FilingView #filing-empty {
    height: 1;
}

FilingEditor {
    height: auto;
    max-height: 16;
    layout: vertical;
    padding: 0;
}

FilingEditor HorizontalGroup {
    height: 1;
    margin: 0;
    padding: 0;
    align: left middle;
}

FilingEditor .filing-label {
    width: auto;
    height: 1;
    padding: 0 1 0 0;
}

FilingEditor .filing-lead {
    width: 12;
}

FilingEditor .filing-value {
    width: 1fr;
    height: 1;
}

/* Moving Mail is intentionally denser than the shared form default. */
FilingEditor Input,
FilingEditor Select {
    height: 1;
    min-height: 1;
    border: none;
    padding: 0 1;
    margin: 0 1 0 0;
}

/* A one-row control cannot spare a row for a focus border. Use a raised
   surface instead so the active text-entry control remains obvious. */
FilingEditor Input:focus {
    border: none;
    background: #243545;
    color: #f5f8fb;
}

/* The shared focus border would consume the only row and hide the Select text/arrow. */
FilingEditor Select:focus {
    border: none;
}

FilingEditor SelectCurrent {
    height: 1;
    min-height: 1;
    border: none;
    padding: 0 1;
}

FilingEditor .filing-field {
    width: 1fr;
    max-width: 54;
}

/* Parent and Folder entry fields use the same width; the picker is a separate wider control. */
FilingEditor .filing-parent-field,
FilingEditor .filing-folder-field {
    width: 48;
    max-width: 48;
}

FilingEditor #filing-parent-options {
    width: 30;
    min-width: 30;
}

/* Shortcut help is already shown in the Footer; do not duplicate it here. */
FilingEditor #filing-shortcuts {
    display: none;
}

FilingEditor #filing-status,
FilingEditor #filing-row-status,
FilingEditor #filing-heading {
    height: 1;
    margin: 0;
    padding: 0;
}

/* Keep row-level guidance compact. The top ACTION NEEDED banner owns the
   warning background; an empty row-status line must not render as a brown bar. */
FilingEditor #filing-row-status.warning {
    background: transparent;
}
