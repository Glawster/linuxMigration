/* Colour roles come from myStyles.css, including the warning palette. */

.action-needed {
    height: auto;
    border: none;
    text-style: bold;
}

Screen > TabbedContent {
    height: 1fr;
}

Screen > TabbedContent > ContentSwitcher {
    height: 1fr;
}

#inboxInterest {
    height: 1fr;
}

#digest-menu {
    height: 1fr;
}

#digest-menu > ContentSwitcher {
    height: 1fr;
}

#digestSenders,
#digestReasons,
#inboxFiling {
    height: 1fr;
}

FilingView {
    height: 1fr;
    layout: vertical;
    overflow: hidden;
}

FilingView #filing-summary {
    height: 1;
}

FilingView #filing-table {
    height: 1fr;
    min-height: 8;
    scrollbar-gutter: stable;
    overflow-x: hidden;
}

FilingView #filing-empty {
    height: 1;
}

FilingEditor {
    height: auto;
    max-height: 32;
    layout: vertical;
    padding: 0;
}

FilingEditor HorizontalGroup {
    height: auto;
    margin: 0;
    padding: 0;
    align: left middle;
}

FilingEditor .filing-label {
    width: auto;
    padding: 0 1 0 0;
}

FilingEditor .filing-lead {
    width: 12;
}

FilingEditor .filing-value {
    width: 1fr;
}

FilingEditor .filing-field {
    width: 1fr;
    max-width: 54;
    margin: 0 1 0 0;
}

FilingEditor .filing-parent-field {
    max-width: 42;
}

FilingEditor .filing-folder-field {
    max-width: 64;
}

FilingEditor #filing-parent-options {
    width: 12;
    margin: 0 1 0 0;
}

FilingEditor #filing-status,
FilingEditor #filing-shortcuts {
    height: 1;
    margin: 0;
    padding: 0;
}
